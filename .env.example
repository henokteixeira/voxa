# Copy to .env and fill in. Never commit .env.

# API (NestJS)
API_PORT=3000
DATABASE_URL=postgres://voxa:voxa@localhost:5432/voxa
ANTHROPIC_API_KEY=
# Claude model used for conversations
ANTHROPIC_MODEL=claude-opus-5-5
# Thinking effort for each turn: low (fastest, default), medium or high
ANTHROPIC_EFFORT=low
# Optional: a model or effort for one kind of call, as task=model@effort pairs, comma-separated.
# Tasks: tutor_open, tutor_turn, review_cue, review_check, mission_model, mission_expression, memory, check_in, assess.
# e.g. ANTHROPIC_TASKS=review_check=claude-haiku-5-5@low,mission_expression=claude-haiku-5-5@low
ANTHROPIC_TASKS=
# Your first language (BCP 47). The tutor writes on-screen help in it. Default: pt-BR
LEARNER_FIRST_LANGUAGE=pt-BR
# Facts about you that the tutor uses in scenes (role, projects, vocabulary).
# Personal data: keep it out of git. Path is relative to apps/api.
TUTOR_CONTEXT_FILE=../../tutor-context.md

# Local voice service (Python)
VOICE_SERVICE_URL=http://localhost:8001
# How long the API waits for STT/TTS before showing an error (ms)
VOICE_TIMEOUT_MS=30000
# Extra STT wait per second of speech (ms), so a long turn is not cut off
VOICE_STT_MS_PER_AUDIO_SECOND=2000

# Docker: where the web app and the API listen. 127.0.0.1 (default) = this computer only;
# 0.0.0.0 = the local network too (e.g. a phone), with no login: only on a network you trust.
VOXA_HOST=127.0.0.1

# Web (Vite): leave unset, so the app calls /api on its own address (localhost, the computer's IP or a
# Tailscale HTTPS address). Set it only to reach an API somewhere else.
# VITE_API_URL=
